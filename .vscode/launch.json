    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--systems",
                "ROI",
                "--input",
                "D:/archive/hd_files/data_analysis/50_laboratory_notebooks/SOD-Laboratory/Imaging/data/input/LSIMG",
                "--output",
                "C:/SOD_OUTPUT",
                "--compile",
                "--settings",
                "workflows/settings.json"
            ]
        },
        {
            "name": "archive_transform_rgb_ngr",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--archive",
                "--copy",
                "--transform",
                "--input",
                "C:/Data/projects/ProjectManySystems/NGR",
                "--output",
                "C:/Data/projects/ProjectManySystems/derp",
                "--system",
                "NGR",
                "--settings",
                "workflows/settings.json",
                "--step",
                "--recursive",
                "--force"
              
            ]
        },
        {
            "name": "help_menu",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--help",
            ]
        },
                {
            "name": "compile_ngr",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
             
                "--compile",
                "--input",
                "C:/Data/projects/ProjectManySystems/NGR",
                "--output",
                "C:/Data/projects/ProjectManySystems/derp",
                "--system",
                "NGR",
                "--settings",
                "workflows/settings.json",
                "--step",
                "--recursive",
                "--force"
            ]
        },
        {
            "name": "archive_only_rgb",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--archive",
                "--input",
                "C:/Data/projects/ProjectManySystems/instrument_files",
                "--output",
                "C:/Data/projects/ProjectManySystems",
